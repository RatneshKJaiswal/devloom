# Database (Azure Database for PostgreSQL with PgBouncer)
DATABASE_URL="postgresql://user:password@host.postgres.database.azure.com:6432/devloom?sslmode=require"

# Auth.js (NextAuth v5)
AUTH_SECRET="your-32-byte-hex-or-base64-secret"
AUTH_GITHUB_ID="github-oauth-client-id"
AUTH_GITHUB_SECRET="github-oauth-client-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Token Security (AES-256-GCM key: 32 bytes as 64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Gemini API (AI Agent)
GEMINI_API_KEY="your-gemini-api-key"

# Agent Cost Controls & Quotas
AGENT_DAILY_REQUEST_LIMIT="50"
AGENT_DAILY_TOKEN_LIMIT="100000"
MAX_DAILY_GLOBAL_AGENT_BUDGET_CENTS="500"
