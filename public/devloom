// Main CLI router
async function main() {
  const [,, cmd, ...args] = process.argv;

  if (!cmd || cmd === "help" || cmd === "--help" || cmd === "-h") {
    showHelp();
    return;
  }

  switch (cmd) {
    case "login":
      await cmdLogin();
      break;
    case "whoami":
      await cmdWhoami();
      break;
    case "task":
      await cmdTask(args);
      break;
    case "bug":
      await cmdBug(args);
      break;
    case "gotcha":
    case "learning":
      await cmdGotcha(args);
      break;
    case "capture":
      await cmdCapture(args);
      break;
    case "standup":
    case "plan":
      await cmdStandup();
      break;
    case "branch":
      await cmdBranch(args);
      break;
    case "list":
    case "ls":
      await cmdList(args);
      break;
    default:
      error(`Unknown command '${cmd}'. Run 'devloom help' for usage.`);
      process.exit(1);
  }
}

main().catch((err) => {
  error(`Fatal: ${err.message}`);
  process.exit(1);
});
