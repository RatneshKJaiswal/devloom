async function cmdCapture(args) {
  const config = loadConfig();
  if (!config) {
    error("Not logged in. Run 'devloom login' to authenticate.");
    process.exit(1);
  }

  const rawInput = args.join(" ").trim();
  if (!rawInput) {
    error("Provide input text or URL to capture. Usage: devloom capture 'Fix auth timeout issue'");
    process.exit(1);
  }

  info("Analyzing with DevLoom Smart Capture...");

  try {
    const res = await apiRequest({
      method: "POST",
      endpoint: "/api/agent/capture",
      body: {
        rawInput,
        autoSave: true,
      },
      config,
    });

    const payload = res.data;
    if (payload.createdItem) {
      const type = payload.type || "item";
      success(`Auto-captured as ${colors.bold}${type.toUpperCase()}${colors.reset}: ${payload.createdItem.title}`);
      if (payload.redirectUrl) {
        print(`  Web URL: ${config.apiUrl}${payload.redirectUrl}`);
      }
    } else if (payload.intent) {
      info(`Identified intent: ${payload.intent.type} - "${payload.intent.title}"`);
    }
  } catch (err) {
    error(`Capture failed: ${err.message}`);
    process.exit(1);
  }
}

async function cmdStandup() {
  const config = loadConfig();
  if (!config) {
    error("Not logged in. Run 'devloom login' to authenticate.");
    process.exit(1);
  }

  info("Generating standup & daily plan summary...");

  try {
    const res = await apiRequest({
      method: "POST",
      endpoint: "/api/agent/summary",
      body: { mode: "daily_plan" },
      config,
    });

    const plan = res.data;
    print(`\n${colors.bold}${colors.cyan}══════════════════════════════════════════════════${colors.reset}`);
    print(`${colors.bold}◆ DevLoom Daily Standup & Engineering Focus${colors.reset}`);
    print(`${colors.bold}${colors.cyan}══════════════════════════════════════════════════${colors.reset}\n`);

    if (plan.summary) {
      print(`${colors.bold}Overview:${colors.reset}\n${plan.summary}\n`);
    }

    if (plan.focusItems && plan.focusItems.length > 0) {
      print(`${colors.bold}Top Priorities for Today:${colors.reset}`);
      for (const item of plan.focusItems) {
        const idBadge = item.taskNumber ? `[TSK-${item.taskNumber}]` : item.bugNumber ? `[BUG-${item.bugNumber}]` : "";
        print(`  • ${colors.green}${idBadge}${colors.reset} ${item.title} ${colors.dim}(${item.priority})${colors.reset}`);
      }
      print("");
    }

    if (plan.blockers && plan.blockers.length > 0) {
      print(`${colors.bold}${colors.red}Blockers & Critical Risks:${colors.reset}`);
      for (const b of plan.blockers) {
        print(`  ⚠ ${b.title || b}`);
      }
      print("");
    }
  } catch (err) {
    error(`Failed to fetch standup: ${err.message}`);
    process.exit(1);
  }
}

async function cmdBranch(args) {
  const config = loadConfig();
  if (!config) {
    error("Not logged in. Run 'devloom login' to authenticate.");
    process.exit(1);
  }

  let doCheckout = false;
  const filteredArgs = [];
  for (const a of args) {
    if (a === "-c" || a === "--checkout") {
      doCheckout = true;
    } else {
      filteredArgs.push(a);
    }
  }

  const query = filteredArgs.join(" ").trim();
  if (!query) {
    error("Specify task/bug number or title. E.g. devloom branch TSK-3");
    process.exit(1);
  }

  let branchName = "";

  // If format is TSK-X or BUG-X
  const tskMatch = query.match(/^tsk-(\d+)/i);
  const bugMatch = query.match(/^bug-(\d+)/i);

  if (tskMatch) {
    const num = parseInt(tskMatch[1], 10);
    // Find task
    const res = await apiRequest({ method: "GET", endpoint: "/api/tasks", config });
    const match = res.data?.find((t) => t.taskNumber === num);
    const slug = match ? slugify(match.title) : `task-${num}`;
    branchName = `feature/tsk-${num}-${slug}`;
  } else if (bugMatch) {
    const num = parseInt(bugMatch[1], 10);
    const res = await apiRequest({ method: "GET", endpoint: "/api/bugs", config });
    const match = res.data?.find((b) => b.bugNumber === num);
    const slug = match ? slugify(match.title) : `bug-${num}`;
    branchName = `fix/bug-${num}-${slug}`;
  } else {
    branchName = `feature/${slugify(query)}`;
  }

  print(`Branch: ${colors.bold}${colors.cyan}${branchName}${colors.reset}`);

  if (doCheckout) {
    try {
      execSync(`git checkout -b "${branchName}"`, { stdio: "inherit" });
      success(`Checked out new branch: ${branchName}`);
    } catch (err) {
      error(`Failed to checkout git branch: ${err.message}`);
    }
  } else {
    print(`Run: ${colors.yellow}git checkout -b ${branchName}${colors.reset}`);
  }
}

async function cmdList(args) {
  const config = loadConfig();
  if (!config) {
    error("Not logged in. Run 'devloom login' to authenticate.");
    process.exit(1);
  }

  const sub = (args[0] || "tasks").toLowerCase();

  try {
    if (sub.startsWith("bug")) {
      const res = await apiRequest({ method: "GET", endpoint: "/api/bugs", config });
      print(`\n${colors.bold}DevLoom Bugs (${res.data?.length || 0}):${colors.reset}`);
      for (const b of (res.data || []).slice(0, 15)) {
        const num = b.bugNumber ? `BUG-${b.bugNumber}` : b.id.slice(0, 6);
        print(`  ${colors.red}${num.padEnd(8)}${colors.reset} [${b.status.padEnd(8)}] ${b.title}`);
      }
    } else if (sub.startsWith("gotcha") || sub.startsWith("learning")) {
      const res = await apiRequest({ method: "GET", endpoint: "/api/learnings", config });
      print(`\n${colors.bold}DevLoom Gotchas (${res.data?.length || 0}):${colors.reset}`);
      for (const g of (res.data || []).slice(0, 15)) {
        print(`  ${colors.magenta}${g.category.padEnd(10)}${colors.reset} [Box ${g.box}] ${g.title}`);
      }
    } else {
      const res = await apiRequest({ method: "GET", endpoint: "/api/tasks", config });
      print(`\n${colors.bold}DevLoom Tasks (${res.data?.length || 0}):${colors.reset}`);
      for (const t of (res.data || []).slice(0, 15)) {
        const num = t.taskNumber ? `TSK-${t.taskNumber}` : t.id.slice(0, 6);
        print(`  ${colors.cyan}${num.padEnd(8)}${colors.reset} [${t.status.padEnd(11)}] ${t.title}`);
      }
    }
    print("");
  } catch (err) {
    error(`Failed to list ${sub}: ${err.message}`);
    process.exit(1);
  }
}

