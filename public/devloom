#!/usr/bin/env node

/**
 * DevLoom CLI — Developer Command Center & Terminal Suite
 * Zero-dependency, native Node.js executable.
 */

import fs from "fs";
import path from "path";
import os from "os";
import http from "http";
import https from "https";
import readline from "readline";
import { execSync } from "child_process";

const CONFIG_DIR = path.join(os.homedir(), ".devloom");
const CONFIG_FILE = path.join(CONFIG_DIR, "config.json");

// ANSI color helpers
const colors = {
  reset: "\x1b[0m",
  bold: "\x1b[1m",
  dim: "\x1b[2m",
  green: "\x1b[32m",
  yellow: "\x1b[33m",
  blue: "\x1b[34m",
  magenta: "\x1b[35m",
  cyan: "\x1b[36m",
  red: "\x1b[31m",
};

function print(msg = "") {
  console.log(msg);
}

function error(msg) {
  console.error(`${colors.red}${colors.bold}Error:${colors.reset} ${msg}`);
}

function success(msg) {
  console.log(`${colors.green}${colors.bold}✓${colors.reset} ${msg}`);
}

function info(msg) {
  console.log(`${colors.cyan}${colors.bold}ℹ${colors.reset} ${msg}`);
}

// Config file management
function loadConfig() {
  const envUrl = process.env.DEVLOOM_API_URL || process.env.DEVLOOM_URL;
  const envToken = process.env.DEVLOOM_TOKEN || process.env.DEVLOOM_PAT;

  if (envToken) {
    return {
      apiUrl: envUrl || "http://localhost:3000",
      token: envToken,
    };
  }

  if (fs.existsSync(CONFIG_FILE)) {
    try {
      const raw = fs.readFileSync(CONFIG_FILE, "utf-8");
      const parsed = JSON.parse(raw);
      if (envUrl) parsed.apiUrl = envUrl;
      return parsed;
    } catch {
      // Ignore parse errors and return null
    }
  }

  return null;
}

function saveConfig(config) {
  if (!fs.existsSync(CONFIG_DIR)) {
    fs.mkdirSync(CONFIG_DIR, { recursive: true, mode: 0o700 });
  }
  fs.writeFileSync(CONFIG_FILE, JSON.stringify(config, null, 2), {
    mode: 0o600,
  });
}

// Native HTTP client
function apiRequest({ method = "GET", endpoint, body = null, config }) {
  return new Promise((resolve, reject) => {
    const fullUrl = new URL(endpoint, config.apiUrl);
    const isHttps = fullUrl.protocol === "https:";
    const transport = isHttps ? https : http;

    const payload = body ? JSON.stringify(body) : null;
    const headers = {
      Accept: "application/json",
      Authorization: `Bearer ${config.token}`,
    };

    if (payload) {
      headers["Content-Type"] = "application/json";
      headers["Content-Length"] = Buffer.byteLength(payload);
    }

    const req = transport.request(
      fullUrl,
      {
        method,
        headers,
      },
      (res) => {
        let responseBody = "";
        res.on("data", (chunk) => {
          responseBody += chunk;
        });

        res.on("end", () => {
          let data = null;
          try {
            data = responseBody ? JSON.parse(responseBody) : {};
          } catch {
            data = { raw: responseBody };
          }

          if (res.statusCode >= 200 && res.statusCode < 300) {
            resolve({ status: res.statusCode, data });
          } else {
            const errMsg =
              data?.error || data?.message || `HTTP ${res.statusCode} ${res.statusMessage}`;
            reject(new Error(errMsg));
          }
        });
      }
    );

    req.on("error", (err) => {
      reject(new Error(`Network request failed: ${err.message}`));
    });

    if (payload) {
      req.write(payload);
    }
    req.end();
  });
}

function prompt(question) {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
  });
  return new Promise((resolve) => {
    rl.question(question, (answer) => {
      rl.close();
      resolve(answer.trim());
    });
  });
}

function slugify(text) {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "")
    .slice(0, 40);
}

// Commands
async function cmdLogin() {
  print(`${colors.bold}${colors.cyan}◆ DevLoom CLI Setup & Authentication${colors.reset}\n`);

  const currentConfig = loadConfig() || {};
  const defaultUrl = currentConfig.apiUrl || "http://localhost:3000";

  const apiUrl = (await prompt(`Enter DevLoom App URL [${defaultUrl}]: `)) || defaultUrl;
  const token = await prompt(`Enter Personal Access Token (devloom_pat_...): `);

  if (!token || !token.startsWith("devloom_pat_")) {
    error("Invalid token. Personal Access Tokens must start with 'devloom_pat_'");
    process.exit(1);
  }

  const testConfig = { apiUrl, token };
  info("Verifying credentials with DevLoom server...");

  try {
    const res = await apiRequest({
      method: "GET",
      endpoint: "/api/account/tokens",
      config: testConfig,
    });

    saveConfig(testConfig);
    success(`Authentication verified! Config saved to ${CONFIG_FILE}`);
    print(`${colors.dim}You have ${res.data?.length || 0} active token(s) registered.${colors.reset}\n`);
  } catch (err) {
    error(`Authentication failed: ${err.message}`);
    process.exit(1);
  }
}

async function cmdWhoami() {
  const config = loadConfig();
  if (!config) {
    error("Not logged in. Run 'devloom login' to authenticate.");
    process.exit(1);
  }

  try {
    const res = await apiRequest({
      method: "GET",
      endpoint: "/api/account/tokens",
      config,
    });

    print(`${colors.bold}${colors.cyan}DevLoom Session${colors.reset}`);
    print(`  API URL: ${colors.green}${config.apiUrl}${colors.reset}`);
    print(`  Tokens:  ${res.data?.length || 0} active token(s)`);
    if (res.data && res.data.length > 0) {
      for (const t of res.data) {
        print(`    - ${colors.bold}${t.name}${colors.reset} (${t.tokenPrefix})`);
      }
    }
  } catch (err) {
    error(`Failed to verify session: ${err.message}`);
    process.exit(1);
  }
}

async function cmdTask(args) {
  const config = loadConfig();
  if (!config) {
    error("Not logged in. Run 'devloom login' to authenticate.");
    process.exit(1);
  }

  let title = "";
  let priority = "medium";
  let description = "";

  for (let i = 0; i < args.length; i++) {
    if (args[i] === "--priority" || args[i] === "-p") {
      priority = args[++i] || "medium";
    } else if (args[i] === "--desc" || args[i] === "-d") {
      description = args[++i] || "";
    } else if (!args[i].startsWith("-")) {
      title += (title ? " " : "") + args[i];
    }
  }

  if (!title) {
    title = await prompt("Task title: ");
    if (!title) {
      error("Task title cannot be empty");
      process.exit(1);
    }
  }

  try {
    const res = await apiRequest({
      method: "POST",
      endpoint: "/api/tasks",
      body: {
        title,
        priority: priority.toLowerCase(),
        description: description || undefined,
        status: "todo",
      },
      config,
    });

    const task = res.data;
    const taskNumberStr = task.taskNumber ? `TSK-${task.taskNumber}` : `Task #${task.id.slice(0, 8)}`;
    success(`Created ${colors.bold}${taskNumberStr}${colors.reset}: ${task.title}`);
    print(`  Status:   ${colors.yellow}${task.status}${colors.reset}`);
    print(`  Priority: ${task.priority}`);
    print(`  Web URL:  ${config.apiUrl}/tasks?selected=${task.id}`);
  } catch (err) {
    error(`Failed to create task: ${err.message}`);
    process.exit(1);
  }
}

